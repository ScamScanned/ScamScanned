{
  "manifest_version": 3,
  "name": "ScamScanned Alpha",
  "description": "Warns about risky marketplace listing patterns on Amazon, Walmart, eBay, Etsy and local trade. Runs locally in your browser.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_title": "ScamScanned Alpha"
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://scamscanned.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.amazon.com/*"],
      "js": ["sensor-amazon.js"],
      "all_frames": true,
      "run_at": "document_start",
      "match_about_blank": true
    },
    {
      "matches": ["*://*.walmart.com/*"],
      "js": ["sensor-walmart.js"],
      "all_frames": true,
      "run_at": "document_start",
      "match_about_blank": true
    },
    {
      "matches": ["*://*.ebay.com/*"],
      "js": ["sensor-ebay.js"]
    },
    {
      "matches": ["*://*.etsy.com/*"],
      "js": ["sensor-etsy.js"]
    },
    {
      "matches": ["*://*.craigslist.org/*", "*://*.facebook.com/*"],
      "js": ["sensor-local.js"]
    }
  ]
}
